{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "account-route": {
        "ClusterId": "account-cluster",
        "Match": { "Path": "/api/accounts/{**catch-all}" }
      },
      "card-route": {
        "ClusterId": "card-cluster",
        "Match": { "Path": "/api/cards/{**catch-all}" }
      },
      "authorization-route": {
        "ClusterId": "authorization-cluster",
        "Match": { "Path": "/api/authorizations/{**catch-all}" }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/api/transactions/{**catch-all}" }
      },
      "installment-route": {
        "ClusterId": "installment-cluster",
        "Match": { "Path": "/api/installments/{**catch-all}" }
      },
      "fraud-route": {
        "ClusterId": "fraud-cluster",
        "Match": { "Path": "/api/fraud/{**catch-all}" }
      },
      "eod-route": {
        "ClusterId": "eod-cluster",
        "Match": { "Path": "/api/eod/{**catch-all}" }
      },
      "reconciliation-route": {
        "ClusterId": "reconciliation-cluster",
        "Match": { "Path": "/api/reconciliation/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-destination": { "Address": "http://localhost:5001/" }
        }
      },
      "account-cluster": {
        "Destinations": {
          "account-destination": { "Address": "http://localhost:5002/" }
        }
      },
      "card-cluster": {
        "Destinations": {
          "card-destination": { "Address": "http://localhost:5003/" }
        }
      },
      "authorization-cluster": {
        "Destinations": {
          "authorization-destination": { "Address": "http://localhost:5004/" }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-destination": { "Address": "http://localhost:5005/" }
        }
      },
      "installment-cluster": {
        "Destinations": {
          "installment-destination": { "Address": "http://localhost:5006/" }
        }
      },
      "fraud-cluster": {
        "Destinations": {
          "fraud-destination": { "Address": "http://localhost:5007/" }
        }
      },
      "eod-cluster": {
        "Destinations": {
          "eod-destination": { "Address": "http://localhost:5008/" }
        }
      },
      "reconciliation-cluster": {
        "Destinations": {
          "reconciliation-destination": { "Address": "http://localhost:5009/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": { "Address": "http://localhost:5010/" }
        }
      }
    }
  }
}
